import random

# 1. Define Win Combinations (Rows, Columns, Diagonals)
WIN_COMBOS = [
    (0, 1, 2), (3, 4, 5), (6, 7, 8),  # Rows
    (0, 3, 6), (1, 4, 7), (2, 5, 8),  # Columns
    (0, 4, 8), (2, 4, 6)              # Diagonals
]

def print_board(board):
    """Renders the current board state."""
    print(f"\n {board[0]} | {board[1]} | {board[2]} ")
    print("-----------")
    print(f" {board[3]} | {board[4]} | {board[5]} ")
    print("-----------")
    print(f" {board[6]} | {board[7]} | {board[8]} \n")

def check_winner(board, player):
    """Returns True if the specified player has achieved a winning combination."""
    return any(board[a] == board[b] == board[c] == player for a, b, c in WIN_COMBOS)

def is_board_full(board):
    """Returns True if there are no empty slots left."""
    return ' ' not in board

def get_computer_move(board):
    """Smart AI: Wins if possible, blocks human wins, otherwise takes strategic slots."""
    # Rule 1: Can Computer ('O') win in this move?
    for i in range(9):
        if board[i] == ' ':
            board_copy = board.copy()
            board_copy[i] = 'O'
            if check_winner(board_copy, 'O'):
                return i

    # Rule 2: Can Human ('X') win next turn? If so, block them.
    for i in range(9):
        if board[i] == ' ':
            board_copy = board.copy()
            board_copy[i] = 'X'
            if check_winner(board_copy, 'X'):
                return i

    # Rule 3: Strategic choices (Center -> Corners -> Edges)
    if board[4] == ' ': return 4
    
    corners = [i for i in [0, 2, 6, 8] if board[i] == ' ']
    if corners: return random.choice(corners)
    
    edges = [i for i in [1, 3, 5, 7] if board[i] == ' ']
    return random.choice(edges) if edges else None

def play_game():
    """Main game orchestration engine."""
    board = [' '] * 9
    print("Welcome to Tic-Tac-Toe! You are 'X', Computer is 'O'.")
    print("Enter positions from 1 to 9 corresponding to top-left to bottom-right.")
    print_board([str(i+1) for i in range(9)]) # Display reference map

    while True:
        # --- HUMAN TURN ---
        while True:
            try:
                move = int(input("Your move (1-9): ")) - 1
                if 0 <= move <= 8 and board[move] == ' ':
                    board[move] = 'X'
                    break
                print("Invalid move. Spot taken or out of range. Try again.")
            except ValueError:
                print("Please enter a valid number between 1 and 9.")

        print_board(board)
        if check_winner(board, 'X'):
            print(" Congratulations! You beat the computer!")
            break
        if is_board_full(board):
            print(" It's a draw!")
            break

        # --- COMPUTER TURN ---
        print("Computer is thinking...")
        comp_move = get_computer_move(board)
        board[comp_move] = 'O'
        
        print_board(board)
        if check_winner(board, 'O'):
            print(" Computer wins! Better luck next time.")
            break
        if is_board_full(board):
            print(" It's a draw!")
            break

if __name__ == "__main__":
    play_game()
